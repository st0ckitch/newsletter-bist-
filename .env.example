# --- App ---
PORT=3000
# Public base URL of this admin tool (used in reminder emails and photo links)
APP_BASE_URL=http://localhost:3000
# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and uploaded photos are stored
DATA_DIR=./data

# --- First-run admin account (created only if the users table is empty) ---
# Leave ADMIN_PASSWORD empty to have a random password generated and printed
# in the server log on first start.
ADMIN_EMAIL=admin@bist.ge
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# --- Mailchimp (https://mailchimp.com/developer/marketing/guides/quick-start/) ---
# API key from Mailchimp: Account -> Extras -> API keys
MAILCHIMP_API_KEY=
# Server prefix is the part after the dash in your API key / dashboard URL, e.g. us21
MAILCHIMP_SERVER_PREFIX=
# Audience (list) ID that the PARENTS newsletter draft is created for
MAILCHIMP_AUDIENCE_ID=
# Optional: separate audience for TEACHER reminder emails (defaults to MAILCHIMP_AUDIENCE_ID)
MAILCHIMP_TEACHERS_AUDIENCE_ID=

# --- Circle partner offers (the Partner offers section at the bottom) ---
# The Circle API's newsletter feed and its token (NEWSLETTER_TOKEN on the API)
CIRCLE_FEED_URL=
CIRCLE_FEED_TOKEN=

# --- Staff photos (headshots from the school website's team page) ---
# Defaults to https://bist.ge/our-team/; leave empty to turn it off.
# STAFF_PHOTOS_URL=
