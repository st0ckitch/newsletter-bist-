<%- include('partials/head', { title: 'Users' }) %>
<div class="page-head">
  <h1>Staff accounts</h1>
  <div class="page-actions"><a class="btn btn-primary" href="/users/new">+ Add user</a></div>
</div>
<% if (created) { %><div class="alert alert-ok">User created - share the login details with them.</div><% } %>

<% if (locals.importReport) { %>
  <div class="alert alert-ok">
    <strong>Import finished:</strong> <%= importReport.created.length %> account(s) created,
    <%= importReport.existing.length %> already existed (left untouched),
    <%= importReport.invalid.length %> line(s) skipped as invalid.
  </div>
  <% if (importReport.created.length) { %>
    <div class="card"><h2>Created (no password yet - send invites below)</h2>
      <table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Area</th></tr></thead><tbody>
        <% importReport.created.forEach(function(u) { %>
          <tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.section ? (sections[u.section] || u.section) : '-' %></td></tr>
        <% }) %>
      </tbody></table>
    </div>
  <% } %>
  <% if (importReport.invalid.length) { %>
    <div class="alert alert-warn"><strong>Skipped lines:</strong> <%= importReport.invalid.join(' · ') %></div>
  <% } %>
<% } %>

<% if (locals.inviteResult) { %>
  <% if (inviteResult.sent) { %>
    <div class="alert alert-ok">
      <strong>Invitations sent to <%= inviteResult.sentTo.length %> staff member(s).</strong>
      Each email carries a personal &quot;Create your password&quot; link.
      <% if (inviteResult.failed && inviteResult.failed.length) { %>
        <br>⚠ Could not reach: <%= inviteResult.failed.map(function(f){ return f.email + ' (' + f.error + ')'; }).join('; ') %>
      <% } %>
    </div>
  <% } else { %>
    <div class="alert alert-error"><strong>No invitations were sent:</strong> <%= inviteResult.reason %></div>
  <% } %>
<% } %>

<% if (locals.isSiteAdmin) { %>
<div class="grid-2">
  <div class="card">
    <h2>Import staff</h2>
    <p class="muted">Paste (or choose a file with) one person per line: <code>Name,email</code> - optionally
    <code>Name,email,role,area</code> (role: staff / slt / marketing / principal / admin; area for SLT:
    whole_school / primary / secondary / sixth_form / co_curricular). Header rows and duplicates are skipped,
    and <strong>existing accounts are never modified</strong>. Imported accounts have no password until their
    owner activates them through the invitation email.</p>
    <form method="post" action="/users/import">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>CSV file <input type="file" id="csv-file" accept=".csv,text/csv,text/plain"></label>
      <label>Rows to import
        <textarea name="csv" id="csv-text" rows="6" placeholder="Caradoc Peters,c.peters@bist.ge&#10;Samuel Murray,s.murray@bist.ge,slt,secondary"></textarea>
      </label>
      <button class="btn btn-primary" data-confirm="Create accounts for every new email in the list? Nobody can log in until they set a password through their invitation email.">Import accounts</button>
    </form>
  </div>
  <div class="card">
    <h2>Invitation emails</h2>
    <p class="muted">Each invitation is a branded Mailchimp email with a <strong>personal login link</strong>: the
    recipient opens it, creates a password, and lands in the dashboard. <strong><%= newInvites %></strong> account(s)
    have never been emailed; <strong><%= pendingInvites %></strong> still have no password overall. The main button
    only emails people who have <em>never</em> received an invite, so already-invited staff are not emailed again.
    Use the reminder button (or the per-row buttons below) to re-send - a re-send replaces the earlier link.</p>
    <form method="post" action="/users/send-invites" data-confirm="Email a personal login link to every account that has never been invited yet?" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="scope" value="new">
      <button class="btn btn-primary" <%= newInvites ? '' : 'disabled' %>>Send invites to <%= newInvites %> new</button>
    </form>
    <form method="post" action="/users/send-invites" data-confirm="Re-send an invitation to EVERY account still without a password, including people already emailed? Their earlier links stop working." class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="scope" value="all">
      <button class="btn btn-ghost" <%= pendingInvites ? '' : 'disabled' %>>Re-send reminders to all <%= pendingInvites %> not activated</button>
    </form>
  </div>
</div>
<% } %>
<div class="card">
  <table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Role &amp; area</th><th>Reset password</th><th></th></tr></thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.name %>
            <% if (u.invited) { %><br><span class="tag tag-pending">✉ invited<%= u.invite_sent_at ? '' : ' - email not sent yet' %></span>
            <% } %>
          </td>
          <td><%= u.email %></td>
          <td>
            <form method="post" action="/users/<%= u.id %>/role" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <select name="role" class="slot-select">
                <% assignableRoles.concat(assignableRoles.includes(u.role) ? [] : [u.role]).forEach(function(r) { %>
                  <option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
              <select name="section" class="slot-select">
                <option value="">- all areas -</option>
                <% sectionKeys.forEach(function(k) { %>
                  <option value="<%= k %>" <%= u.section === k ? 'selected' : '' %>><%= sections[k] %></option>
                <% }) %>
              </select>
              <button class="btn btn-ghost btn-sm">Set</button>
            </form>
            <span class="muted"><%= roleLabels[u.role] || u.role %></span>
          </td>
          <td>
            <form method="post" action="/users/<%= u.id %>/password" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="password" name="password" placeholder="new password (8+)" minlength="8" required>
              <button class="btn btn-ghost btn-sm">Set</button>
            </form>
          </td>
          <td class="row-actions">
            <% if (locals.isSiteAdmin && u.invited) { %>
            <form method="post" action="/users/<%= u.id %>/invite" class="inline-form" <%- u.invite_sent_at ? 'data-confirm="Re-send the invitation email to this person? Their earlier link stops working."' : '' %>>
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-ghost btn-sm"><%= u.invite_sent_at ? 'Re-send invite' : 'Send invite' %></button>
            </form>
            <% } %>
            <% if (u.id !== currentUser.id) { %>
            <form method="post" action="/users/<%= u.id %>/delete" data-confirm="Delete this account?">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-danger btn-sm">Delete</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="card card-narrow">
  <h2>Change my password</h2>
  <form method="post" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field-row">
      <label>Current password <input type="password" name="current_password" required></label>
      <label>New password (8+) <input type="password" name="password" minlength="8" required></label>
    </div>
    <button class="btn btn-primary">Change password</button>
  </form>
</div>
<%- include('partials/foot') %>
