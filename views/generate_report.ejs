<%- include('partials/head', { title: 'Generation report' }) %>
<div class="page-head">
  <h1>Generation report - week of <%= result.weekStart %></h1>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/newsletter/preview">Back to preview</a>
    <a class="btn btn-ghost" href="/newsletter/issues">All issues</a>
  </div>
</div>

<% if (result.status === 'draft_created') { %>
  <div class="alert alert-ok">
    <strong>✅ Draft campaign created in Mailchimp.</strong>
    Nothing was sent - the principal proof-reads and approves the issue, then it is sent from Mailchimp.
    <div class="btn-row" style="margin-top:10px;">
      <% if (result.campaignWebUrl) { %>
        <a class="btn btn-secondary" href="<%= result.campaignWebUrl %>" target="_blank" rel="noopener">Open the draft in Mailchimp</a>
      <% } %>
      <% if (locals.canApprove && locals.issueId) { %>
        <form method="post" action="/newsletter/issues/<%= issueId %>/approve" data-confirm="Approve this issue for sending? Marketing will be told it can be sent from Mailchimp.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-primary">Approve for sending</button>
        </form>
      <% } else { %>
        <a class="btn btn-ghost" href="/newsletter/issues">Issues &amp; approval</a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-error">
    <strong>❌ No draft was created in Mailchimp.</strong>
    The newsletter was saved locally (see Issues), but it did not reach Mailchimp - the failed steps below say exactly why.
  </div>
<% } %>

<div class="card">
  <h2>What happened, step by step</h2>
  <table class="table">
    <tbody>
      <% result.steps.forEach(function(s) { %>
        <tr>
          <td width="30" style="font-size:17px;"><%= s.ok ? '✅' : '❌' %></td>
          <td><strong><%= s.label %></strong><% if (s.detail) { %><br><span class="muted"><%= s.detail %></span><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (result.warnings.length) { %>
<div class="card">
  <h2>Warnings</h2>
  <ul class="plain-list">
    <% result.warnings.forEach(function(w) { %><li>⚠ <%= w %></li><% }) %>
  </ul>
</div>
<% } %>
<%- include('partials/foot') %>
