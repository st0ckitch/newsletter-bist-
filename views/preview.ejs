<%- include('partials/head', { title: 'Preview' }) %>
<% const canEdit = Boolean(locals.can && can.layout); %>
<div class="page-head">
  <h1><%= canEdit ? 'Live editor' : 'Newsletter preview' %> - week of <%= weekStart %></h1>
  <div class="page-actions">
    <a class="btn btn-secondary" href="/newsletter/preview.html?week=<%= weekStart %><%= canEdit ? '&edit=1' : '' %>" target="_blank" rel="noopener">Open full size</a>
    <% if (canEdit) { %>
    <form method="post" action="/demo-data/fill" data-confirm="Fill every template section with sample events, articles, photos and a principal&#39;s message? Content your staff wrote is kept - demo items are marked and can be removed again with one click.">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-secondary">Fill with demo content</button>
    </form>
    <% if (typeof hasDemo !== 'undefined' && hasDemo) { %>
    <form method="post" action="/demo-data/clear" data-confirm="Remove all demo content (and only demo content) from the newsletter?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-ghost">Remove demo content</button>
    </form>
    <% } %>
    <form method="post" action="/newsletter/generate" data-confirm="Aggregate this week&#39;s content and create/update the Mailchimp draft now?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-primary">Generate Mailchimp draft</button>
    </form>
    <% } %>
  </div>
</div>
<% if (typeof submissionWeek !== 'undefined' && submissionWeek !== issueWeek) { %>
  <% if (weekStart === issueWeek) { %>
    <div class="alert alert-ok">The <strong>Thursday cutoff has passed</strong>: this is the issue that was assembled and is being proofed.
    New stories now land in next week's issue - <a href="/newsletter/preview?week=<%= submissionWeek %>">view next week (<%= submissionWeek %>)</a>.</div>
  <% } else if (weekStart === submissionWeek) { %>
    <div class="alert alert-warn">You are viewing <strong>next week's issue</strong> (week of <%= weekStart %>) - stories submitted after the Thursday cutoff collect here.
    <a href="/newsletter/preview">Back to this week's issue</a>.</div>
  <% } %>
<% } %>
<% if (typeof demo !== 'undefined' && demo === 'filled') { %>
  <div class="alert alert-ok">Demo content added - every template section is now filled with sample events, articles, photos and a principal&#39;s message. Use <strong>Remove demo content</strong> to take it out again; anything staff wrote themselves is untouched.</div>
<% } else if (typeof demo !== 'undefined' && demo === 'cleared') { %>
  <div class="alert alert-ok">Demo content removed. Only the sample items were deleted - real submissions were kept.</div>
<% } %>
<% if (canEdit) { %>
  <p class="muted">Edit directly in the preview: <strong>click any text</strong> to change it (Esc undoes, clicking away saves), <strong>hover a photo</strong> to replace or remove it, and use <strong>+ Add photo</strong> inside an article. The 200-word article limit still applies. Photos move to the Mailchimp CDN when the draft is generated.</p>
<% } else { %>
  <p class="muted">Live preview - refresh after adding content. Photos show from local uploads until the issue is generated, when they are moved to the Mailchimp CDN.</p>
<% } %>
<iframe class="preview-frame preview-frame-tall" src="/newsletter/preview.html?week=<%= weekStart %><%= canEdit ? '&edit=1' : '' %>" title="Newsletter preview"></iframe>
<%- include('partials/foot') %>
