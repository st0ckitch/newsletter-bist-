<%- include('partials/head', { title: 'Preview' }) %>
<%
  const canEdit = Boolean(locals.can && can.layout);
  // The frame shows either the working view (live editor for managers,
  // labelled section placeholders for everyone else) or the final email.
  const frameSrc = {
    edit: '/newsletter/preview.html?week=' + weekStart + (canEdit ? '&edit=1' : ''),
    final: '/newsletter/preview.html?week=' + weekStart + '&final=1',
  };
  const pageHref = (d, v) => '/newsletter/preview?week=' + weekStart + '&device=' + d + '&view=' + v;
  const editLabel = canEdit ? 'Live editor' : 'Section highlights';
%>
<div class="page-head">
  <h1><%= canEdit ? 'Live editor' : 'Newsletter preview' %> - week of <%= weekStart %></h1>
  <div class="page-actions">
    <a class="btn btn-secondary" href="<%= frameSrc[view] %>" target="_blank" rel="noopener" data-preview-open>Open full size</a>
    <button type="button" class="btn btn-secondary" data-copy-html="/newsletter/export.html?week=<%= weekStart %>">Copy HTML for Mailchimp</button>
    <% if (canEdit) { %>
    <form method="post" action="/demo-data/fill" data-confirm="Fill every template section with sample events, articles, photos and a principal&#39;s message? Content your staff wrote is kept - demo items are marked and can be removed again with one click.">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-secondary">Fill with demo content</button>
    </form>
    <% if (typeof hasDemo !== 'undefined' && hasDemo) { %>
    <form method="post" action="/demo-data/clear" data-confirm="Remove all demo content (and only demo content) from the newsletter?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-ghost">Remove demo content</button>
    </form>
    <% } %>
    <form method="post" action="/newsletter/generate" data-confirm="Aggregate this week&#39;s content and create/update the Mailchimp draft now?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="btn btn-primary">Generate Mailchimp draft</button>
    </form>
    <% } %>
  </div>
</div>
<% if (typeof submissionWeek !== 'undefined' && submissionWeek !== issueWeek) { %>
  <% if (weekStart === issueWeek) { %>
    <div class="alert alert-ok">The <strong>Thursday cutoff has passed</strong>: this is the issue that was assembled and is being proofed.
    New stories now land in next week's issue - <a href="/newsletter/preview?week=<%= submissionWeek %>">view next week (<%= submissionWeek %>)</a>.</div>
  <% } else if (weekStart === submissionWeek) { %>
    <div class="alert alert-warn">You are viewing <strong>next week's issue</strong> (week of <%= weekStart %>) - stories submitted after the Thursday cutoff collect here.
    <a href="/newsletter/preview">Back to this week's issue</a>.</div>
  <% } %>
<% } %>
<% if (typeof demo !== 'undefined' && demo === 'filled') { %>
  <div class="alert alert-ok">Demo content added - every template section is now filled with sample events, articles, photos and a principal&#39;s message. Use <strong>Remove demo content</strong> to take it out again; anything staff wrote themselves is untouched.</div>
<% } else if (typeof demo !== 'undefined' && demo === 'cleared') { %>
  <div class="alert alert-ok">Demo content removed. Only the sample items were deleted - real submissions were kept.</div>
<% } %>
<% if (canEdit) { %>
<div class="card">
  <h2>Email subject for this issue</h2>
  <p class="muted"><strong>Optional.</strong> This is what parents see in their inbox - tease the week&#39;s most
  exciting stories to make them open it. &quot;The Roar - &quot; is always added in front automatically, so just
  write the teaser: e.g. <em>&#127881; Sports Day results, House Points drama &amp; the Y6 trip</em> becomes
  <em>The Roar - &#127881; Sports Day results, House Points drama &amp; the Y6 trip</em>. Keep the key words
  early (phones cut subjects around 60 characters). Left blank, the standard
  &quot;The Roar - British International School of Tbilisi Weekly Newsletter&quot; is used. Applied to the
  Mailchimp draft when the issue is generated.</p>
  <% if (subjectSaved) { %><div class="alert alert-ok">Subject saved - it will be used when this week&#39;s issue is generated.</div><% } %>
  <form method="post" action="/newsletter/subject" class="inline-form" style="flex-wrap:wrap; gap:8px;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="week" value="<%= weekStart %>">
    <input type="text" name="subject" value="<%= emailSubject %>" maxlength="150" style="flex:1; min-width:260px; margin:0;"
      placeholder="e.g. &#127881; Sports Day results, House Points drama &amp; the Y6 trip">
    <button class="btn btn-primary">Save subject</button>
  </form>
</div>
<% } %>

<div class="preview-toolbar" data-preview-toolbar data-src-edit="<%= frameSrc.edit %>" data-src-final="<%= frameSrc.final %>">
  <div class="seg" role="group" aria-label="Screen size">
    <a class="seg-btn<%= device === 'desktop' ? ' is-on' : '' %>" href="<%= pageHref('desktop', view) %>" data-set-device="desktop">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="1.5" y="2" width="13" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M5.5 14h5M8 11v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      Desktop</a>
    <a class="seg-btn<%= device === 'mobile' ? ' is-on' : '' %>" href="<%= pageHref('mobile', view) %>" data-set-device="mobile">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><rect x="4" y="1.5" width="8" height="13" rx="1.8" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7 12.2h2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      Mobile</a>
  </div>
  <div class="seg" role="group" aria-label="Section highlights">
    <a class="seg-btn<%= view === 'edit' ? ' is-on' : '' %>" href="<%= pageHref(device, 'edit') %>" data-set-view="edit">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 13l.6-2.6 7.2-7.2a1.4 1.4 0 0 1 2 2l-7.2 7.2L3 13z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      <%= editLabel %></a>
    <a class="seg-btn<%= view === 'final' ? ' is-on' : '' %>" href="<%= pageHref(device, 'final') %>" data-set-view="final">
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M1.5 8s2.4-4.5 6.5-4.5S14.5 8 14.5 8 12.1 12.5 8 12.5 1.5 8 1.5 8z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="2" fill="currentColor"/></svg>
      Final email</a>
  </div>
</div>

<p class="muted" data-preview-note="edit"<%= view === 'final' ? ' hidden' : '' %>>
<% if (canEdit) { %>
  Edit directly in the preview: <strong>click any text</strong> to change it (Esc undoes, clicking away saves), <strong>hover a photo</strong> to replace or remove it, and use <strong>+ Add photo</strong> inside an article. The article word limit still applies. Photos move to the Mailchimp CDN when the draft is generated.
<% } else { %>
  Live preview - refresh after adding content. Empty sections show as labelled boxes so you can see where stories go. Photos show from local uploads until the issue is generated, when they are moved to the Mailchimp CDN.
<% } %>
</p>
<p class="muted" data-preview-note="final"<%= view === 'edit' ? ' hidden' : '' %>>
  <strong>Final email</strong> - exactly what parents receive: no section letters, empty-section boxes or editing tools, and empty sections simply don&#39;t appear.
  Switch back to <strong><%= editLabel %></strong> <%= canEdit ? 'to make changes.' : 'to see which sections are still empty.' %>
</p>

<div class="preview-stage" data-preview-stage data-device="<%= device %>">
  <div class="device-shell">
    <div class="device-speaker" aria-hidden="true"></div>
    <iframe class="preview-frame" data-preview-frame src="<%= frameSrc[view] %>" title="Newsletter preview"></iframe>
  </div>
  <p class="device-caption muted">Phone-size screen (390px wide). Gmail and Apple Mail on phones show this layout; Outlook on a computer always shows the desktop one.</p>
</div>
<%- include('partials/foot') %>
