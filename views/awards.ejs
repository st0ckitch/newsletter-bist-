<%- include('partials/head', { title: 'Primary Certificates of Recognition' }) %>
<div class="page-head">
  <h1>Primary Certificates of Recognition</h1>
</div>
<% if (errors.length) { %><div class="alert alert-error"><ul class="plain-list"><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
<% if (moved) { %><div class="alert alert-ok">Moved <%= moved %> row<%= moved === 1 ? '' : 's' %> here - this table is now in <%= isThisWeek ? "this week's" : "next week's" %> newsletter.</div><% } %>

<div class="preview-toolbar">
  <div class="seg" role="group" aria-label="Which issue">
    <% tabs.forEach(function(t) { %>
      <a class="seg-btn<%= t.week === week ? ' is-on' : '' %>" href="/awards?week=<%= t.week %>"><%= t.label %> &middot; <%= t.date %><% if (t.note) { %> (<%= t.note %>)<% } %></a>
    <% }) %>
  </div>
</div>
<p class="muted">Each issue has its own table - what you see on a tab is exactly what that week&#39;s newsletter gets.
<% if (pastCutoff) { %>The <%= cutoff %> deadline has passed: this week&#39;s issue has been put together, so new certificates go into <strong>next week&#39;s</strong> table.<% } %></p>

<% if (draftGenerated) { %>
  <div class="alert alert-warn">This week&#39;s Mailchimp draft has already been generated. After changing this table, press
  <strong>Generate Mailchimp draft</strong> on the <a href="/newsletter/preview">Preview</a> page so the draft includes it.</div>
<% } %>
<% if (isManager && other) { %>
  <form method="post" action="/awards/move" class="inline-form" style="margin:0 0 14px 0; gap:10px; flex-wrap:wrap;"
    data-confirm="Move this whole table<%= topic ? ' and its title' : '' %> to <%= other.label.toLowerCase() %> (<%= other.date %>)?">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="from" value="<%= week %>">
    <input type="hidden" name="to" value="<%= other.week %>">
    <button class="btn btn-secondary btn-sm" <%= rows.length ? '' : 'disabled' %>>Move this table to <%= other.label.toLowerCase() %> &middot; <%= other.date %></button>
    <span class="muted">For a table filled in on the wrong tab - the rows and the title move together.</span>
  </form>
<% } %>

<% if (canChange) { %>
<div class="grid-2">
  <div class="card">
    <h2>Topic title</h2>
    <p class="muted">Shown in gold above the table - what this week&#39;s certificates are for, e.g.
    <em>&quot;Generosity of Spirit Certificate Winners 12.12.25&quot;</em>.</p>
    <form method="post" action="/awards/topic">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="week" value="<%= week %>">
      <label>Title
        <input type="text" name="title" value="<%= topic %>" maxlength="160" placeholder="Generosity of Spirit Certificate Winners 12.12.25">
      </label>
      <button class="btn btn-primary">Save title</button>
    </form>
  </div>
  <div class="card">
    <h2>Add a class</h2>
    <p class="muted">Anyone on the staff can add rows: the class (or group) and the winning students&#39; names.
    Each new issue starts with a fresh table; you can fix or remove the rows you added yourself.</p>
    <form method="post" action="/awards">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="week" value="<%= week %>">
      <div class="field-row">
        <label>Class * <input type="text" name="class_name" required maxlength="120" placeholder="e.g. Year 3W"></label>
        <label>Students * <input type="text" name="students" required maxlength="200" placeholder="e.g. Marta, Renee"></label>
      </div>
      <button class="btn btn-primary">Add to the table</button>
    </form>
  </div>
</div>
<% } else { %>
  <div class="alert alert-warn">This week&#39;s issue has already been put together, so its table is closed. Add new certificates
  on the <a href="/awards?week=<%= other.week %>">next week&#39;s issue</a> tab - or ask marketing if one must still go in this week.</div>
  <% if (topic) { %><p><strong>Title:</strong> <%= topic %></p><% } %>
<% } %>

<div class="card">
  <% if (!rows.length) { %>
    <p class="muted">No rows in this table yet - the Primary Certificates of Recognition block only appears in that
    week&#39;s newsletter once at least one class is added.</p>
  <% } else { %>
  <p class="muted">Drag the <strong>&#8942;&#8942;</strong> grip to change the order of the classes - the
  newsletter table follows it exactly.</p>
  <table class="table">
    <thead><tr><th style="width:28px"></th><th>Class</th><th>Students</th><th>Added by</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function(r) { %>
        <tr data-award-row="<%= r.id %>">
          <td class="drag-grip" title="Drag to reorder" style="cursor:grab; color:#a5adc2; user-select:none; font-size:15px;">&#8942;&#8942;</td>
          <% if (r.canEdit) { %>
          <td colspan="2">
            <form method="post" action="/awards/<%= r.id %>" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="text" name="class_name" value="<%= r.grade_stage %>" required maxlength="120" style="width:120px">
              <input type="text" name="students" value="<%= r.student_name %>" required maxlength="200" style="width:240px">
              <button class="btn btn-ghost btn-sm">Save</button>
            </form>
          </td>
          <% } else { %>
          <td><%= r.grade_stage %></td>
          <td><%= r.student_name %></td>
          <% } %>
          <td class="muted"><%= r.author || '-' %></td>
          <td class="row-actions">
            <% if (r.canEdit) { %>
            <form method="post" action="/awards/<%= r.id %>/delete" data-confirm="Remove this class from the certificates table?">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-danger btn-sm">Delete</button>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<%- include('partials/foot') %>
