<%- include('partials/head', { title: item && item.id ? 'Edit news' : 'New news' }) %>
<div class="grid-2 grid-form-preview">
<div class="card">
  <h1><%= item && item.id ? 'Edit news article' : 'Add a news article' %></h1>
  <% if (errors.length) { %><div class="alert alert-error"><ul class="plain-list"><% errors.forEach(function(e){ %><li><%= e %></li><% }) %></ul></div><% } %>
  <form method="post" action="<%= item && item.id ? '/news/' + item.id : '/news' %>" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Title *
      <input type="text" name="title" value="<%= item ? item.title : '' %>" required maxlength="200" placeholder="e.g. Inter-School Friendly Tennis Tournament Success">
    </label>
    <label>Section *
      <select name="section" required>
        <% sections.forEach(function(s) { %>
          <option value="<%= s %>" <%= item && item.section === s ? 'selected' : '' %>><%= s.replace('_', ' ') %></option>
        <% }) %>
      </select>
    </label>
    <label>Article text * (max <%= maxWords %> words)
      <textarea name="body" rows="10" required data-word-limit="<%= maxWords %>" placeholder="Write the article. Leave an empty line between paragraphs."><%= item ? item.body : '' %></textarea>
    </label>
    <p class="muted"><span data-word-count></span></p>
    <p class="muted"><strong>Links:</strong> paste a URL (https://…) or write <code>[link text](https://…)</code> - both become clickable links in the newsletter.</p>
    <% if (isManager) { %>
    <label>Template section
      <select name="slot">
        <% contentSlots.forEach(function(s) { %>
          <option value="<%= s %>" <%= item && item.slot === s ? 'selected' : '' %>><%= slotLabels[s] %></option>
        <% }) %>
      </select>
    </label>
    <p class="muted">Sections A-C are fixed (header &amp; quote, upcoming events, principal's message). D/F/H fill the left column, E/G/I the right.</p>
    <% } else if (item && item.slot) { %>
      <p class="muted">Template section: <strong><%= slotLabels[item.slot] || item.slot %></strong> - placement is set by the admin.</p>
    <% } %>
    <label>Photos (JPEG/PNG/WebP/GIF, up to 12, max 10&nbsp;MB each)
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple>
    </label>
    <p class="muted">The first photo becomes the large hero image in the newsletter; the rest appear in a two-column grid.<br>
    <strong>Recommended:</strong> landscape photos around <strong>1200 × 800 px</strong> (minimum 800 px wide), JPEG, under <strong>2 MB</strong> each - that is sharp on retina screens (photos run full-width on phones) and keeps the email fast to load. Phone photos work fine; avoid tiny thumbnails and heavy 10 MB originals.</p>
    <div class="btn-row">
      <button type="submit" class="btn btn-primary"><%= item && item.id ? 'Save changes' : 'Add article' %></button>
      <a class="btn btn-secondary" href="/news">Cancel</a>
    </div>
  </form>

  <% if (item && item.id && photos.length) { %>
    <h2>Photos</h2>
    <div class="photo-grid">
      <% photos.forEach(function(p) { %>
        <div class="photo-tile">
          <img src="/uploads/<%= p.filename %>" alt="<%= p.original_name || 'photo' %>">
          <form method="post" action="/photos/<%= p.id %>/delete" data-confirm="Remove this photo?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-danger btn-sm">Remove</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-head-row"><h2>Live preview</h2></div>
  <p class="muted">The article exactly as it will appear in the newsletter column - updates as you type. Photos show once selected; the first one becomes the hero image.</p>
  <iframe id="article-preview" class="preview-frame" title="Article preview"></iframe>
</div>
</div>
<%- include('partials/foot') %>
